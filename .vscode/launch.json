{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/main/main.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "justMyCode": true,
            "preLaunchTask": "stop-main-service"
        },
        {
            "name": "Timer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/timer/timer.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "preLaunchTask": "stop-timer-service"
        },
        {
            "name": "Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/server/server.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "preLaunchTask": "stop-server-service"
        },
        {
            "name": "Tvon",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/tvon/tvon.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "preLaunchTask": "stop-tvon-service"
        }
    ],
    "compounds": [
        {
            "name": "Arcade",
            "configurations": ["Main", "Timer", "Server"],
            "preLaunchTask": "stop-arcade-services",
            "stopAll": true,
            "presentation": {
                "order": 1
            }
        }
    ]
}
